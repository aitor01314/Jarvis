# ============================================================
#  JARVIS — Configuración de APIs (100% GRATUITAS)
#  Copia este archivo a `.env` y rellena las claves que tengas.
#  No necesitas todas: JARVIS usa las que existan, en orden de
#  prioridad, y hace failover automático a la siguiente.
# ============================================================

# ---------- NIVEL 1: Groq (el más rápido, gratis) ----------
# Consíguela en: https://console.groq.com/keys
# Límite gratis: ~30 req/min, ~14.400 req/día (según modelo)
GROQ_API_KEY=

# ---------- NIVEL 2: Google Gemini (gratis, AI Studio) ----------
# Consíguela en: https://aistudio.google.com/apikey
# Límite gratis: 10-15 req/min según modelo, 250-1000 req/día
GEMINI_API_KEY=

# ---------- NIVEL 3: Cerebras (gratis, muy rápido) ----------
# Consíguela en: https://cloud.cerebras.ai/
# Límite gratis: ~30 req/min, ~14.400 req/día
CEREBRAS_API_KEY=

# ---------- NIVEL 4: Mistral (tier gratuito "La Plateforme") ----------
# Consíguela en: https://console.mistral.ai/api-keys
# Límite gratis: 1 req/seg, 500.000 tokens/min
MISTRAL_API_KEY=

# ---------- NIVEL 5: GitHub Models (gratis con tu cuenta GitHub) ----------
# Token en: https://github.com/settings/tokens (permiso models:read)
# Da acceso gratuito limitado a GPT-4o, Llama, Phi, etc.
GITHUB_MODELS_TOKEN=

# ---------- FAILOVER FINAL: OpenRouter (modelos :free) ----------
# Consíguela en: https://openrouter.ai/settings/keys
# Los modelos con sufijo ":free" no cuestan nada (~50 req/día,
# 1000/día si depositas 10$ una sola vez).
# Cuando TODOS los anteriores agoten su límite por minuto,
# JARVIS llama automáticamente aquí.
OPENROUTER_API_KEY=

# ---------- LOCAL: Ollama (sin límites, sin internet) ----------
# Instala https://ollama.com y ejecuta: ollama pull llama3.1
# Último recurso si no hay internet o todo lo demás falla.
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
#  Infraestructura local (docker compose -f infra/docker-compose.yml up -d)
# ============================================================
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ============================================================
#  General
# ============================================================
JARVIS_LANG=es
JARVIS_LOG_LEVEL=INFO
